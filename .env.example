# Postgres. Locally: npm run db:up (Docker, port 5438). On Railway, use
# ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://hindsight:hindsight@localhost:5438/local_hindsight

# How far back each company's history reaches, in days. Start small (183 is
# 6 months) to check the extension works, then raise it (1095 is 3 years).
# The next sync reads only the older stretch that is missing.
BACKFILL_DAYS=183

# Basic auth for the whole app (any username). Leave unset locally.
APP_PASSWORD=

# Token the browser extension sends when Hindsight is deployed. Set any long
# random string here and paste the same value in the extension's settings.
SYNC_TOKEN=

# Bearer token for POST /api/runs, if a scheduler triggers runs over HTTP.
CRON_SECRET=

# Optional overrides (defaults shown).
# RESYNC_DAYS=90
# BENCHMARK_TICKER=SPY
# TARGET_MOVE=0.1
# LOG_LEVEL=info
